{
  "name": "cash-hero-teacher",
  "version": "1.0.0",
  "private": true,
  "description": "Cash Hero - Teacher live lesson panel",
  "scripts": {
    "install-client": "npm install --prefix client --include=dev",
    "build": "npm run install-client && npm run build --prefix client",
    "heroku-postbuild": "npm run build",
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev -- --port=5173 --strictPort",
    "dev:student": "npm --prefix ../Cash.Hero-ai run dev -- --port=3001 --strictPort",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:student\""
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
